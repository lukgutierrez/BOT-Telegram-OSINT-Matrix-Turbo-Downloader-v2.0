# ============================================================
# TELEGRAM OSINT RECON MATRIX & DOWNLOADER - ENVIRONMENT CONFIG
# ============================================================
# Creado por @lukgtz
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env'
# 2. Rellena tus claves de API de Telegram obtenidas en https://my.telegram.org
# 3. (Opcional) Configura tu Bot Token de @BotFather si usas el modo Bot.

# --- CREDENCIALES TELEGRAM (OBLIGATORIO) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=tu_api_hash_aqui_32_caracteres
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- CONFIGURACIÓN DE RENDIMIENTO ---
MAX_CONCURRENT_DOWNLOADS=10
DOWNLOAD_FOLDER=downloads
MAX_FILE_SIZE_MB=50
MAX_FLOOD_WAIT=300

# --- DEDUPLICACIÓN DE ARCHIVOS ---
DEDUP_ENABLE=true
HASH_ALGORITHM=sha256

# --- CONFIGURACIÓN DE PROXY (OPCIONAL) ---
# Activar solo si necesitas descargar grandes volúmenes ocultando tu IP
PROXY_ENABLED=false
PROXY_TYPE=SOCKS5
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_SECRET=

# --- GOOGLE DRIVE DESKTOP SYNC (OPCIONAL) ---
# Letra de unidad montada de Google Drive en Windows (por defecto G:\Mi unidad)
GDRIVE_LOCAL_PATH=G:\Mi unidad
